/target

# Runtime state produced by the kernel (not source, not generated artifacts).
/evidence/*.jsonl
/checkpoints/*.json
/tasks/*.json
.intake/

# Refinery proposals and alternate-target build output are demonstrations,
# regenerable on demand — not committed.
/refinery/proposals/
/dist/

# Local build state: versioned bundle copies and the current-bundle pointer,
# maintained by `harnessc build`. Regenerable; the checked-in Playbook and its
# bundle manifest are the committed artifacts.
/.harnessc/
